# Copy to .env for local work outside Docker. Never commit a real secret.

# --- Backend ---------------------------------------------------------------
# A long random string. Rotating it revokes every access token in existence.
FMS_SECRET_KEY=change-me-to-something-long-and-random
FMS_DATABASE_URL=postgresql+psycopg://fms:fms@localhost:5432/fms
FMS_FILE_STORE_PATH=./var/files
FMS_ENV=local

# Open decisions (section 13) -- the documented defaults are in app/config.py.
# Uncomment only to override one, and update the README's table when you do.
# FMS_DEFAULT_MANAGEMENT_FEE_PCT=0.10
# FMS_DEFAULT_FINAL_WHT_RATE=0.00
# FMS_DEFAULT_DAY_BASIS=365
# FMS_REQUIRED_SIGNATORIES=2
# FMS_TAAJ_RECEIVABLE_ACCOUNT=1320

# Letterhead placeholders (open decision 13) -- a custodian will reject a letter
# that still carries these.
# FMS_FIRM_NAME=SIBK Capital Limited
# FMS_FIRM_ADDRESS=<ADDRESS PLACEHOLDER>, Nairobi, Kenya
# FMS_CMA_LICENCE_NUMBER=<CMA LICENCE NO. PLACEHOLDER>

# --- Frontend --------------------------------------------------------------
# Server-side only: the browser never learns this address.
FMS_API_URL=http://localhost:8000/api/v1
# A random base64 string (e.g. `openssl rand -base64 32`), fixed across restarts
# and redeploys. Without it Next.js generates a new one on every server start,
# which invalidates any Server Action a browser tab already has bound (e.g. the
# login form) -- surfaced as "Failed to find Server Action".
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=change-me-to-a-random-base64-string
